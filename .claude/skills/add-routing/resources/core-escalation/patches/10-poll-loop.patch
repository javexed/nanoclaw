+      singleTurn,
+      routing,
+      processingIds,
+      fallbackName,
+      fallback.onExchangeComplete?.bind(fallback),
+      prompt,
+      undefined,
+      originDests,
+      config.lenientOutput ?? false,
+      config.signal,
+    );
+  } catch (err) {
+    log(`Fallback provider ${fallbackName} failed too: ${err instanceof Error ? err.message : String(err)}`);
+    return null;
+  }
 }
 
