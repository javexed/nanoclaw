+/**
+ * Re-run the current batch on the fallback provider. Returns the fallback's
+ * result, or null when no fallback is configured or the fallback itself
+ * threw. The caller decides whether the fallback result supersedes the
+ * primary's error (it does only when the fallback actually produced output).
+ */
+async function runEscalation(
+  config: PollLoopConfig,
+  routing: RoutingContext,
+  processingIds: string[],
+  prompt: string,
+  originDests: DestinationEntry[],
+): Promise<QueryResult | null> {
+  const fallback = config.fallbackProvider;
+  const fallbackName = config.fallbackProviderName;
+  if (!fallback || !fallbackName) return null;
+  log(`Escalating turn to fallback provider ${fallbackName} (fresh session)`);
+  // Thinking-bubble static line: escalated turns are the slow ones — say so.
+  // 'progress' needs no new status kind anywhere downstream.
+  appendStatusEvent('progress', `Escalating to ${fallbackName.charAt(0).toUpperCase()}${fallbackName.slice(1)}…`);
+  try {
+    const q = fallback.query({
+      prompt,
+      continuation: undefined,
+      cwd: config.cwd,
+      systemContext: config.systemContext,
+    });
+    // Hub-style providers (Claude) keep their query open after a result so
+    // follow-ups reuse the warm session — as the PRIMARY that's the whole
+    // point, but an open FALLBACK query becomes the loop's active query and
+    // silently captures every subsequent message: the group is then stuck on
+    // the fallback until the container recycles. Enforce one-shot at the
+    // stream level: end the query after its first result so processQuery
+    // returns and the next turn starts on the primary.
+    const singleTurn: AgentQuery = {
+      push: (m) => q.push(m),
+      end: () => q.end(),
+      abort: () => q.abort(),
+      events: (async function* () {
+        for await (const ev of q.events) {
+          yield ev;
+          if (ev.type === 'result') break;
+        }
+        q.end();
+      })(),
+    };
