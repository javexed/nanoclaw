
# ── Webchat (in-tree channel) ────────────────────────────────────────────────
# Embedded HTTP + WS chat server with PWA frontend. Disabled by default.
WEBCHAT_ENABLED=false
# WEBCHAT_HOST=127.0.0.1        # bind host; non-loopback requires WEBCHAT_TOKEN
# WEBCHAT_PORT=3100
# WEBCHAT_TOKEN=                # bearer token (min 24 chars); empty = localhost-only auto-auth
# WEBCHAT_PUBLIC_DIR=public/webchat
# WEBCHAT_TLS_CERT=             # optional in-process HTTPS (both must be set)
# WEBCHAT_TLS_KEY=
