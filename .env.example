
# ── Web (in-tree channel) ────────────────────────────────────────────────
# Embedded HTTP + WS chat server with PWA frontend. Disabled by default.
WEB_ENABLED=false
# WEB_HOST=127.0.0.1        # bind host; non-loopback requires WEB_TOKEN
# WEB_PORT=3100
# WEB_TOKEN=                # bearer token (min 24 chars); empty = localhost-only auto-auth
# WEB_PUBLIC_DIR=public/web
# WEB_TLS_CERT=             # optional in-process HTTPS (both must be set)
# WEB_TLS_KEY=

# Learning (see docs/web/README.md, "Learning")
# NANOCLAW_LEARNING_MODEL=          # model for the /learn review pass; empty = the turn model
# NANOCLAW_OVERLAP_MODEL=           # local model to judge overlap on Keep; empty = heuristic only
# NANOCLAW_OVERLAP_URL=http://127.0.0.1:11434

# Local models run on OpenCode (/add-opencode). Assigning a local roster model in
# the web UI writes these; set them by hand only for an install without the UI.
# OPENCODE_PROVIDER=openai
# OPENCODE_BASE_URL=http://host.docker.internal:11434/v1
# OPENCODE_MODEL=openai/qwen3:8b
# OPENCODE_SMALL_MODEL=openai/qwen3:8b  # titles/summaries; unset, OpenCode asks
#                                       # for its own cloud default and a local
#                                       # endpoint 404s every side task
# OPENCODE_MODEL_CONTEXT_LIMIT=32768     # both limits are required by OpenCode
# OPENCODE_MODEL_OUTPUT_LIMIT=8192
# NO_PROXY=host.docker.internal          # so a host backend bypasses the credential proxy

# Which harness a NEW agent group is created on. Stamped at creation, never
# consulted at spawn, so existing groups are never retroactively flipped and a
# change takes effect for groups made after the next restart. Setup writes it
# from the provider you pick; choosing a local default model in the web UI
# writes it too. Per-group `ncl groups config update --provider` still wins.
# DEFAULT_AGENT_PROVIDER=claude

# Set by the setup wizard when you enable the web UI and also ask for a
# messaging app. Read back on a re-exec (sg docker, fail-retry), which rebuilds
# the skip list from scratch and would otherwise forget the answer.
# NANOCLAW_WEB_PLUS_CHANNEL=false
