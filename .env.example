
# ── Web (in-tree channel) ────────────────────────────────────────────────
# Embedded HTTP + WS chat server with PWA frontend. Disabled by default.
WEB_ENABLED=false
# WEB_HOST=127.0.0.1        # bind host; non-loopback requires WEB_TOKEN
# WEB_PORT=3100
# WEB_TOKEN=                # bearer token (min 24 chars); empty = localhost-only auto-auth
# WEB_PUBLIC_DIR=public/web
# WEB_TLS_CERT=             # optional in-process HTTPS (both must be set)
# WEB_TLS_KEY=
